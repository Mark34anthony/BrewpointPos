rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isActive() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    function isAdmin() {
      return isActive() && userRole() == "admin";
    }

    function isCashier() {
      return isActive() && userRole() == "cashier";
    }

    function isBarista() {
      return isActive() && userRole() == "barista";
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isActive() && request.auth.uid == userId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isActive() && request.auth.uid == userId);
    }

    match /products/{productId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isActive();
      allow create: if isCashier();

      allow update: if isAdmin()
        || isBarista()
        || (isCashier() && resource.data.cashierId == request.auth.uid);

      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAdmin();
      allow create: if isCashier();
      allow update, delete: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }
  }
}
